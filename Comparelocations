# ========================================
# SharePoint Location Comparison
# Using REST API (more reliable)
# ========================================

$SiteUrl = "https://cranenxt.sharepoint.com/sites/NXT-CBS"
$OutputPath = "C:\Reports"

Write-Host "`nSharePoint Location Comparison`n" -ForegroundColor Green
Write-Host "Site: $SiteUrl`n"

if (-not (Test-Path $OutputPath)) {
    New-Item -ItemType Directory -Path $OutputPath -Force | Out-Null
}

# Connect to SharePoint
Write-Host "Connecting to SharePoint..."
try {
    Connect-PnPOnline -Url $SiteUrl -Interactive
    Write-Host "Connected!`n" -ForegroundColor Green
} catch {
    Write-Host "Connection failed: $_" -ForegroundColor Red
    Read-Host "Press Enter to exit"
    exit
}

# Get AllActiveUsers using REST API
Write-Host "Fetching AllActiveUsers..."
try {
    $restUrl = "$SiteUrl/_api/web/lists/getbytitle('AllActiveUsers')/items?`$select=Title,Location&`$top=5000"
    $allUsers = @()
    
    do {
        $response = Invoke-PnPSPRestMethod -Url $restUrl -Method Get
        $allUsers += $response.value
        $restUrl = $response."odata.nextLink"
    } while ($restUrl)
    
    Write-Host "Found $($allUsers.Count) users`n" -ForegroundColor Green
} catch {
    Write-Host "ERROR: $_" -ForegroundColor Red
    Write-Host "Make sure list name is 'AllActiveUsers' (case-sensitive)" -ForegroundColor Yellow
    Disconnect-PnPOnline
    Read-Host "Press Enter to exit"
    exit
}

# Get TranslationTable using REST API
Write-Host "Fetching TranslationTable..."
try {
    $restUrl = "$SiteUrl/_api/web/lists/getbytitle('TranslationTable')/items?`$select=PS_Location&`$top=5000"
    $translations = @()
    
    do {
        $response = Invoke-PnPSPRestMethod -Url $restUrl -Method Get
        $translations += $response.value
        $restUrl = $response."odata.nextLink"
    } while ($restUrl)
    
    Write-Host "Found $($translations.Count) records`n" -ForegroundColor Green
} catch {
    Write-Host "ERROR: $_" -ForegroundColor Red
    Write-Host "Make sure list name is 'TranslationTable' (case-sensitive)" -ForegroundColor Yellow
    Disconnect-PnPOnline
    Read-Host "Press Enter to exit"
    exit
}

# Extract unique locations
Write-Host "Processing data..."
$userLocations = $allUsers | Where-Object {$_.Location} | Select-Object -ExpandProperty Location -Unique | Sort-Object
$translationLocations = $translations | Where-Object {$_.PS_Location} | Select-Object -ExpandProperty PS_Location -Unique | Sort-Object

Write-Host "`nUnique Locations Found:" -ForegroundColor Cyan
Write-Host "  AllActiveUsers: $($userLocations.Count) locations"
Write-Host "  TranslationTable: $($translationLocations.Count) locations`n"

# Create results
$results = @()

# Missing in TranslationTable
Write-Host "Analyzing locations..."
foreach ($location in $userLocations) {
    if ($location -notin $translationLocations) {
        $count = @($allUsers | Where-Object {$_.Location -eq $location}).Count
        $results += [PSCustomObject]@{
            Location = $location
            Status = "MISSING in TranslationTable"
            Users = $count
            Action = "ADD"
        }
    }
}

# Matched
foreach ($location in $userLocations) {
    if ($location -in $translationLocations) {
        $count = @($allUsers | Where-Object {$_.Location -eq $location}).Count
        $results += [PSCustomObject]@{
            Location = $location
            Status = "OK - Matched"
            Users = $count
            Action = "None"
        }
    }
}

# Missing in AllActiveUsers
foreach ($location in $translationLocations) {
    if ($location -notin $userLocations) {
        $results += [PSCustomObject]@{
            Location = $location
            Status = "MISSING in AllActiveUsers"
            Users = 0
            Action = "REVIEW"
        }
    }
}

# Display Results
Write-Host "`n════════════════════════════════════════" -ForegroundColor Cyan
Write-Host "COMPARISON RESULTS:" -ForegroundColor Cyan
Write-Host "════════════════════════════════════════`n" -ForegroundColor Cyan

$missingInTT = @($results | Where-Object {$_.Status -eq "MISSING in TranslationTable"}).Count
$missingInAU = @($results | Where-Object {$_.Status -eq "MISSING in AllActiveUsers"}).Count
$matched = @($results | Where-Object {$_.Status -eq "OK - Matched"}).Count

Write-Host "✓ Matched: $matched" -ForegroundColor Green
Write-Host "✗ Missing in TranslationTable: $missingInTT" -ForegroundColor Red
Write-Host "✗ Missing in AllActiveUsers: $missingInAU" -ForegroundColor Yellow

if ($missingInTT -gt 0) {
    Write-Host "`n──────────────────────────────────────────" -ForegroundColor Red
    Write-Host "MISSING IN TRANSLATIONTABLE (ACTION NEEDED):" -ForegroundColor Red
    Write-Host "──────────────────────────────────────────" -ForegroundColor Red
    $results | Where-Object {$_.Status -eq "MISSING in TranslationTable"} | ForEach-Object {
        Write-Host "  ✗ $($_.Location) [$($_.Users) users]"
    }
}

if ($missingInAU -gt 0) {
    Write-Host "`n──────────────────────────────────────────" -ForegroundColor Yellow
    Write-Host "MISSING IN ALLACTIVEUSERS (REVIEW THESE):" -ForegroundColor Yellow
    Write-Host "──────────────────────────────────────────" -ForegroundColor Yellow
    $results | Where-Object {$_.Status -eq "MISSING in AllActiveUsers"} | ForEach-Object {
        Write-Host "  ⚠ $($_.Location)"
    }
}

Write-Host "`n"

# Export to CSV
Write-Host "Exporting report..." -ForegroundColor Green
$csvPath = "$OutputPath\LocationComparison_$(Get-Date -Format 'yyyyMMdd_HHmmss').csv"

try {
    $results | Export-Csv -Path $csvPath -NoTypeInformation
    Write-Host "✓ Report saved: $csvPath" -ForegroundColor Green
} catch {
    Write-Host "ERROR exporting: $_" -ForegroundColor Red
}

Write-Host "`n════════════════════════════════════════`n" -ForegroundColor Green

Disconnect-PnPOnline

Write-Host "Done! Press Enter to close..." -ForegroundColor Green
Read-Host
